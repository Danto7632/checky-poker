# Build-time feature flags (ADR-0012). Copy to .env.local to override. Release builds use these defaults.
# Values are read only in src/config/flags.ts (lead).

# Dormant server features and the legacy API client (Phase 2). Keep false.
VITE_FEATURE_SERVER=false
# Korean strings, /ko/ landing, hreflang. false builds contain no Hangul (scan-dist S4).
VITE_FEATURE_KO=false
# Local LLM (Ollama) provider. Set to false if the W5 manual check fails.
VITE_FEATURE_LOCAL_LLM=true
# /arena and the "Watch bots play" home card.
VITE_FEATURE_ARENA=true
# Landing demo slot (static poster when false).
VITE_FEATURE_LANDING_DEMO=true
# TURN credentials (D26: not used in Phase 1).
VITE_FEATURE_TURN=false
# Comma separated UI languages that get the adult-confirmation step (G-03), e.g. "ko". Empty = none.
VITE_ADULT_CHECK=
# Test hooks (window.__CHECKY_E2E__). Release builds MUST keep false; scan-dist S7 fails otherwise.
VITE_E2E=false

# Phase 2 only — used by the dormant API client when VITE_FEATURE_SERVER=true.
# VITE_API_BASE_URL=http://localhost:3000

# VITE_APP_VERSION is filled by vite.config.ts from `git rev-parse --short=7 HEAD`. Do not set it by hand.
